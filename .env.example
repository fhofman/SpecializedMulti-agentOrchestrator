# Copiá este archivo a .env y completá tus claves (.env está en .gitignore)
OPENAI_API_KEY=sk-...
TAVILY_API_KEY=tvly-...
OPENAI_MODEL=gpt-4o-mini

# Arize Phoenix (observabilidad). Local: `uv run phoenix serve` -> http://localhost:6006
PHOENIX_TRACING=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=vuln-orchestrator
# Solo para Phoenix Cloud (app.phoenix.arize.com):
# PHOENIX_API_KEY=...
